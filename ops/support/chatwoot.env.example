# Copy to /srv/docker/chatwoot.env on the box (NOT into git) and fill in every
# line marked CHANGE. Generate secrets with:  openssl rand -hex 64
# Based on https://github.com/chatwoot/chatwoot/blob/master/.env.example

# CHANGE: long random hex. Rotating it signs everyone out of Chatwoot.
SECRET_KEY_BASE=CHANGE_ME
FRONTEND_URL=https://help.betterat.cricket
FORCE_SSL=true
# Leave false. The first administrator is made on the install screen, and
# nobody else should be able to open a Chatwoot account on our box.
ENABLE_ACCOUNT_SIGNUP=false

RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
RAILS_MAX_THREADS=5

# The service names from chatwoot.compose.yml.
POSTGRES_HOST=chatwoot-postgres
POSTGRES_USERNAME=postgres
# CHANGE: the same value as CHATWOOT_POSTGRES_PASSWORD in /srv/docker/.env.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DATABASE=chatwoot
# CHANGE: random string. It is part of REDIS_URL below, keep the two in step.
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@chatwoot-redis:6379

# Email to Jack and Elton (new conversation, mention, assignment). Without SMTP
# nothing is emailed and they only see the web and mobile app notifications.
MAILER_SENDER_EMAIL=BetterCricket Support <support@bettersports.com.au>
SMTP_DOMAIN=bettersports.com.au
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# Attachments stay on the chatwoot_storage volume.
ACTIVE_STORAGE_SERVICE=local
