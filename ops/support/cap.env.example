# Add these lines to /srv/docker/.env on the box (NOT into git). Compose reads
# that file for the ${...} values in cap.compose.yml, and refuses to start with
# the message after :? if one is empty.
# Secrets: openssl rand -hex 32   (the encryption key must be exactly 64 hex chars)

CAP_URL=https://cap.betterat.cricket
CAP_S3_PUBLIC_URL=https://cap-files.betterat.cricket
CAP_MYSQL_PASSWORD=CHANGE_ME
CAP_MYSQL_ROOT_PASSWORD=CHANGE_ME
CAP_DATABASE_ENCRYPTION_KEY=CHANGE_ME
CAP_NEXTAUTH_SECRET=CHANGE_ME
CAP_MEDIA_SERVER_WEBHOOK_SECRET=CHANGE_ME
CAP_MINIO_ROOT_USER=CHANGE_ME
CAP_MINIO_ROOT_PASSWORD=CHANGE_ME
# Optional, for emailed sign-in links:
CAP_RESEND_API_KEY=
CAP_RESEND_FROM_DOMAIN=
