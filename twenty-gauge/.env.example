# Twenty CRM base URL — self-hosted for this instance, no trailing /api prefix
# (confirmed against the live workspace via backend/app/services/twenty_client.py
# in the main BetterStats repo).
TWENTY_BASE_URL=https://twenty.betterat.cricket

# Settings -> API & Webhooks -> + Create key (Bearer token). Never commit the real value.
TWENTY_API_KEY=

# Annual/period pipeline target this gauge measures against.
TARGET_AMOUNT=80000

# Display symbol shown in the big number and sub-label.
CURRENCY_SYMBOL=$

# ISO currency code returned in the API response's "currency" field (separate
# from CURRENCY_SYMBOL above — see README "Deviations from the brief").
CURRENCY_CODE=AUD

# Comma-separated Opportunity "stage" values to exclude from the sum.
# Default matches this exact workspace's real pipeline stage (see
# docs/twenty-crm-integration.md section 3.4 in the main BetterStats repo) —
# NOT a generic "LOST" placeholder, which won't match anything here.
EXCLUDED_STAGES=Lost / Dormant

# Space-separated origins allowed to iframe this page, e.g. https://twenty.betterat.cricket
ALLOWED_FRAME_ANCESTORS=https://twenty.betterat.cricket

PORT=8000
