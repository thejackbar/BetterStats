# BetterStats environment — copy to .env and fill in values

# Postgres password (choose something strong)
DB_PASSWORD=changeme_strong_password

# JWT secret key (any long random string, 32+ chars)
SECRET_KEY=changeme_jwt_secret_32chars_minimum

# Comma-separated list of allowed origins (your public domain)
CORS_ORIGINS=https://betterat.cricket

# Optional: sponsor banner shown on club dashboards
VITE_SPONSOR_IMAGE=
VITE_SPONSOR_URL=
VITE_SPONSOR_TEXT=
PLAYHQ_BASE_URL=https://grassrootsapiproxy.cricket.com.au
# PlayHQ partner API key — used for match results and fixtures (x-api-key header)
PLAYHQ_API_KEY=

# Anthropic API key — used for AI yearbook narrative generation
ANTHROPIC_API_KEY=
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# KlubPro → BetterStats migration tooling (super-admin onboarding only).
# Leave blank in normal operation — the migration admin page stays "not
# configured" until set. On the box both Postgres run in the same Docker project
# so this resolves over the internal network. NEVER commit the real password.
#   KLUBPRO_DATABASE_URL=postgresql+asyncpg://klubpro_admin:<pw>@klubpro-postgres:5432/klubpro
KLUBPRO_DATABASE_URL=

# --- Applecross Cricket Club ---
# To onboard Applecross, run:
#   curl -X POST http://localhost:8000/api/organisations/onboard \
#     -H "Content-Type: application/json" \
#     -d '{"org_id": "a9d3d71b-87d8-eb11-a7ad-2818780da0cc"}'
# Then set below so the Navbar auto-routes to the club:
VITE_DEFAULT_ORG_ID=a9d3d71b-87d8-eb11-a7ad-2818780da0cc

# Optional sponsor banner
# VITE_SPONSOR_IMAGE=https://example.com/sponsor-logo.png
# VITE_SPONSOR_URL=https://sponsor.com
# VITE_SPONSOR_TEXT=Our Club Sponsor
